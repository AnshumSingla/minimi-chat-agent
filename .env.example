# Copy to .env.local and fill in.

# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Required: Exa search API key (https://dashboard.exa.ai)
EXA_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5-5   # default for the UI model picker
# AGENT_EFFORT=low            # low | medium | high
# AGENT_MAX_ITERATIONS=6      # max model<->search round trips per turn
# MINIMI_DB_PATH=./data/minimi.db
